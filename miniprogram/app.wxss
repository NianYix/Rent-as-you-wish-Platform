page {
  background: #f3f6f2;
  color: #1f2937;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.price {
  color: #c2410c;
  font-weight: 600;
}

.btn-primary {
  background: #1b5e3b;
  color: #fff;
  border-radius: 12rpx;
}

.btn-ghost {
  background: #e8f0eb;
  color: #1b5e3b;
  border-radius: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 16rpx 0 20rpx;
}

.empty {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 0;
}
