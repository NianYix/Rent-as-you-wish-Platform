.page { padding-bottom: 40rpx; }
.top-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, #1b5e3b 0%, #2f7d52 100%);
}
.region, .search {
  background: rgba(255,255,255,.95);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
}
.region { max-width: 240rpx; overflow: hidden; white-space: nowrap; }
.search { flex: 1; color: #6b7280; }
.banner { height: 280rpx; margin: 20rpx 24rpx; border-radius: 16rpx; overflow: hidden; }
.banner-img { width: 100%; height: 280rpx; }
.banner-fallback {
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #d9efe3, #f5f0e6);
  color: #1b5e3b; font-size: 36rpx; font-weight: 600;
}
.section { padding: 8rpx 24rpx 0; }
.cat-grid { display: flex; flex-wrap: wrap; background: #fff; border-radius: 16rpx; padding: 12rpx 0; }
.cat-item { width: 25%; text-align: center; padding: 16rpx 0; font-size: 24rpx; }
.cat-icon {
  width: 72rpx; height: 72rpx; line-height: 72rpx; margin: 0 auto 8rpx;
  border-radius: 20rpx; background: #e8f0eb; color: #1b5e3b; font-weight: 600;
}
.product, .merchant {
  display: flex; gap: 20rpx; background: #fff; border-radius: 16rpx;
  padding: 20rpx; margin-bottom: 16rpx;
}
.cover {
  width: 160rpx; height: 160rpx; border-radius: 12rpx;
  background: #dce8e0; color: #1b5e3b; display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; font-weight: 600; flex-shrink: 0;
}
.cover-img {
  width: 160rpx; height: 160rpx; border-radius: 12rpx; flex-shrink: 0; background: #dce8e0;
}
.meta { flex: 1; }
.name { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.sub { color: #6b7280; font-size: 24rpx; margin-top: 8rpx; }
.m-name { font-weight: 600; font-size: 30rpx; }
