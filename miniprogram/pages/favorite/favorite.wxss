.card{margin:20rpx 24rpx;background:#fff;border-radius:16rpx;padding:24rpx}
.row{display:flex;gap:16rpx;align-items:center}
.thumb{width:120rpx;height:120rpx;border-radius:12rpx;flex-shrink:0;background:#dce8e0}
.placeholder{display:flex;align-items:center;justify-content:center;color:#1b5e3b;font-size:36rpx;font-weight:600}
.info{flex:1}
.name{font-weight:600}
