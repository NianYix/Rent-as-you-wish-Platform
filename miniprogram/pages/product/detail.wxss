.gallery { height: 520rpx; background: #dce8e0; }
.g-img, .g-fallback { width: 100%; height: 520rpx; }
.g-fallback { display:flex; align-items:center; justify-content:center; font-size:40rpx; color:#1b5e3b; }
.card { margin: 20rpx 24rpx; background:#fff; border-radius:16rpx; padding:24rpx; }
.name { font-size:36rpx; font-weight:600; }
.price { margin-top:12rpx; font-size:40rpx; color:#c2410c; font-weight:700; }
.deposit, .sub { color:#6b7280; margin-top:8rpx; }
.h { font-weight:600; margin-bottom:12rpx; }
.txt { line-height:1.6; color:#374151; }
.bottom {
  position: fixed; left:0; right:0; bottom:0; display:flex; gap:12rpx;
  padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background:#fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.06);
}
.bottom button { flex:1; font-size:26rpx; }
.page { padding-bottom: 160rpx; }
