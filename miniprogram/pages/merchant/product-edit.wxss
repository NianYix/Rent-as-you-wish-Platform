.card{margin:24rpx;background:#fff;border-radius:16rpx;padding:24rpx}
.label{margin:16rpx 0 8rpx;color:#4b5563}
input,textarea,.picker{background:#f3f6f2;padding:16rpx;border-radius:12rpx}
textarea{min-height:120rpx;width:100%;box-sizing:border-box}
button{margin-top:28rpx}

.img-grid{display:flex;flex-wrap:wrap;gap:16rpx}
.img-item,.img-add{
  width:200rpx;height:200rpx;border-radius:12rpx;position:relative;overflow:hidden;
  background:#f3f6f2;
}
.thumb{width:100%;height:100%}
.img-add{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  color:#1b5e3b;border:2rpx dashed #9cb8a8;font-size:24rpx;
}
.plus{font-size:48rpx;line-height:1;margin-bottom:4rpx}
.cover-tag{
  position:absolute;left:0;top:0;background:rgba(27,94,59,.9);color:#fff;
  font-size:20rpx;padding:4rpx 10rpx;border-bottom-right-radius:8rpx;
}
.img-actions{
  position:absolute;left:0;right:0;bottom:0;display:flex;justify-content:space-between;
  background:rgba(0,0,0,.55);color:#fff;font-size:20rpx;padding:6rpx 10rpx;
}
.img-actions .del{color:#fecaca}
