<view class="page">
  <view class="card">
    <view class="label">商家名称</view>
    <input data-key="merchant_name" bindinput="onInput" placeholder="如：东风镇便民租赁" />
    <view class="label">联系电话</view>
    <input data-key="phone" bindinput="onInput" placeholder="手机号" />
    <view class="label">微信号（用户点击后可见）</view>
    <input data-key="wechat" bindinput="onInput" placeholder="微信号" />
    <view class="label">地址</view>
    <input data-key="address" bindinput="onInput" placeholder="详细地址" />
    <view class="label">营业时间</view>
    <input data-key="business_hours" bindinput="onInput" value="{{form.business_hours}}" />
    <view class="label">商家介绍</view>
    <textarea data-key="description" bindinput="onInput" placeholder="主营范围" />
    <button class="btn-primary" bindtap="submit">提交入驻申请</button>
  </view>
</view>
