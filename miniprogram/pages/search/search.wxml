<view class="box">
  <view class="bar">
    <input placeholder="搜索帐篷、桌椅、挖掘机..." value="{{keyword}}" bindinput="onInput" confirm-type="search" bindconfirm="onSearch" />
    <button size="mini" class="btn-primary" bindtap="onSearch">搜索</button>
  </view>
  <view class="item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="goProduct">
    <image wx:if="{{item.cover_image}}" class="thumb" src="{{item.cover_image}}" mode="aspectFill" />
    <view wx:else class="thumb placeholder">{{item.name[0]}}</view>
    <view class="info">
      <view class="name">{{item.name}}</view>
      <view class="price">{{formatPrice(item)}}</view>
      <view class="sub">{{item.address}}</view>
    </view>
  </view>
  <view wx:if="{{!items.length}}" class="empty">输入关键词开始搜索</view>
</view>
